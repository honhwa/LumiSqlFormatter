<UserControl x:Class="LumiSqlFormatter.UI.Views.SnippetSuggestionPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="520"
             Width="520" Height="240"
             FontFamily="Segoe UI" FontSize="12">

    <Border x:Name="MainBorder" BorderBrush="#1E88E5" BorderThickness="1.5" Background="#252526" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Direction="315" ShadowDepth="3" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border x:Name="HeaderBorder" Grid.Row="0" Background="#1E88E5" Padding="6,4">
                <DockPanel>
                    <TextBlock x:Name="HeaderTitle" Text="⚡ Lumi SQL Snippets" FontWeight="SemiBold" Foreground="White" FontSize="11"/>
                    <TextBlock x:Name="HeaderHint" Text="Tab / Enter để chọn  •  Esc để đóng" HorizontalAlignment="Right" Foreground="#E3F2FD" FontSize="10"/>
                </DockPanel>
            </Border>

            <!-- Body: List on Left, Preview on Right -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Suggestions List -->
                <ListBox x:Name="SuggestionsList" Grid.Column="0" 
                         Background="#2D2D30" Foreground="#F1F1F1"
                         BorderThickness="0,0,1,0" BorderBrush="#3F3F46"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="SuggestionsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Shortcut Badge -->
                                <Border Grid.Column="0" Background="#0E639C" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Shortcut}" FontWeight="Bold" Foreground="White" FontSize="11"/>
                                </Border>

                                <!-- Description -->
                                <TextBlock Grid.Column="1" Text="{Binding Description}" 
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=Tag}" FontSize="11" 
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Right: Template Preview -->
                <Grid x:Name="PreviewContainer" Grid.Column="1" Background="#1E1E1E">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PreviewLabel" Grid.Row="0" Text="Preview Template:" Foreground="#858585" FontSize="10" Margin="6,4,0,2"/>

                    <TextBox x:Name="PreviewBox" Grid.Row="1" 
                             IsReadOnly="True" 
                             FontFamily="Consolas, Courier New" FontSize="11"
                             Background="#1E1E1E" Foreground="#DCDCDC"
                             BorderThickness="0" Padding="6,2"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
