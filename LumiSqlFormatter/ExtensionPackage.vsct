<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidLumiSqlPackage">
    <Menus>
      <!-- Top Level Menu on Main Menu Bar -->
      <Menu guid="guidLumiSqlCmdSet" id="TopLevelMenu" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_TOOL_MAINMENU" />
        <Strings>
          <ButtonText>Lumi SQL</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidLumiSqlCmdSet" id="TopLevelMenuGroup" priority="0x0600">
        <Parent guid="guidLumiSqlCmdSet" id="TopLevelMenu"/>
      </Group>
      
      <!-- Also add to Tools menu for convenience -->
      <Group guid="guidLumiSqlCmdSet" id="ToolsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidLumiSqlCmdSet" id="cmdidOpenSettings" priority="0x0100" type="Button">
        <Parent guid="guidLumiSqlCmdSet" id="TopLevelMenuGroup" />
        <Strings>
          <ButtonText>Settings &amp; Snippet Manager...</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <CommandPlacement guid="guidLumiSqlCmdSet" id="cmdidOpenSettings" priority="0x0100">
      <Parent guid="guidLumiSqlCmdSet" id="ToolsMenuGroup" />
    </CommandPlacement>
  </CommandPlacements>

  <Symbols>
    <GuidSymbol name="guidLumiSqlPackage" value="{87E8E012-3F9C-4CD6-86A9-D97DDF8097E1}" />
    
    <GuidSymbol name="guidLumiSqlCmdSet" value="{D38D3551-7667-4B52-9A47-9759247E64B2}">
      <IDSymbol name="TopLevelMenu" value="0x1020" />
      <IDSymbol name="TopLevelMenuGroup" value="0x1030" />
      <IDSymbol name="ToolsMenuGroup" value="0x1040" />
      <IDSymbol name="cmdidOpenSettings" value="0x0100" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
